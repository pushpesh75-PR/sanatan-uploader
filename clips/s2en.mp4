window.google.ac.h(["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939",[["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0935\u0927",0,[512,433]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0915\u0940 \u092A\u094D\u0930\u0924\u093F\u091C\u094D\u091E\u093E",0,[512,433]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u092F\u0941\u0926\u094D\u0927",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0915\u0939\u093E\u0928\u0940",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0914\u0930 \u092A\u0930\u0936\u0941\u0930\u093E\u092E \u0915\u093E \u092F\u0941\u0926\u094D\u0927",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0915\u093E \u0935\u0927",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0935\u0927 \u0936\u094D\u0930\u0940 \u0915\u0943\u0937\u094D\u0923\u093E",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0915\u094B \u092C\u093E\u0923\u094B\u0902 \u0915\u0940 \u0936\u0948\u092F\u093E \u0915\u094D\u092F\u094B\u0902 \u092E\u093F\u0932\u0940",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0905\u0930\u094D\u091C\u0941\u0928 \u0915\u093E \u092F\u0941\u0926\u094D\u0927",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0914\u0930 \u0915\u0943\u0937\u094D\u0923 \u0915\u093E \u092F\u0941\u0926\u094D\u0927",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 song",0,[512]],["\u092D\u0940\u0937\u094D\u092E \u092A\u093F\u0924\u093E\u092E\u0939 \u0914\u0930 \u0905\u0930\u094D\u091C\u0941\u0928 \u0915\u093E \u092F\u0941\u0926\u094D\u09