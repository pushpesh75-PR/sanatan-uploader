window.google.ac.h(["\u0915\u0943\u0937\u094D\u0923 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A",[["\u0915\u0943\u0937\u094D\u0923 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A",0,[512]],["\u0915\u0943\u0937\u094D\u0923 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A \u092E\u0939\u093E\u092D\u093E\u0930\u0924",0,[512]],["\u0936\u094D\u0930\u0940 \u0915\u0943\u0937\u094D\u0923 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A \u092E\u0939\u093E\u092D\u093E\u0930\u0924",0,[22,30]],["\u092D\u0917\u0935\u093E\u0928 \u0936\u094D\u0930\u0940 \u0915\u0943\u0937\u094D\u0923 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A \u092E\u0939\u093E\u092D\u093E\u0930\u0924",0,[22,30]],["\u0915\u0943\u0937\u094D\u0923 \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A \u0907\u0928 \u092E\u0939\u093E\u092D\u093E\u0930\u0924",0,[22,30]],["\u0915\u0943\u0937\u094D\u0923 \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A",0,[22,30]],["\u0915\u0943\u0937\u094D\u0923 \u091C\u0940 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A",0,[22,30]],["\u092E\u0939\u093E\u092D\u093E\u0930\u0924 \u092E\u0947\u0902 \u0915\u0943\u0937\u094D\u0923 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A",0,[22,30]],["\u0915\u0943\u0937\u094D\u0923 \u092D\u0917\u0935\u093E\u0928 \u0915\u093E \u0935\u093F\u0930\u093E\u091F \u0930\u0942\u092A",0,[512,546,650]]],{"k":1}])