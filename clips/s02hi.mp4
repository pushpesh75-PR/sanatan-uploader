window.google.ac.h(["\u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",[["\u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",0,[512,433,131]],["\u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u0938\u0941\u0928\u093E\u0913",0,[512]],["\u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u0938\u0941\u0928\u093E\u0907\u090F",0,[512]],["\u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u0915\u093E\u0930\u094D\u0924\u093F\u0915 \u0915\u0940",0,[512]],["\u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u0915\u0925\u093E",0,[512]],["\u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u092C\u0930\u0941\u0906\u0938\u093E\u0917\u0930",0,[22,30]],["\u0924\u0941\u0932\u0938\u0940 \u092E\u093E\u0924\u093E \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u091B\u094B\u091F\u0940 \u0938\u0940",0,[22,30]],["\u0924\u0941\u0932\u0938\u0940 \u0935\u093F\u0935\u093E\u0939 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",0,[22,30]],["\u0932\u0915\u094D\u0937\u094D\u092E\u0940 \u0924\u0941\u0932\u0938\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",0,[22,30]],["\u0924\u0941\u0932\u0938\u0940 \u092E\u093E\u0924\u093E \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u092C\u0924\u093E\u0907\u090F",0,[22,30]],["\u0924\u0941\u0932\u0938\u0940\u0926\u093E\u0938 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",0,[22,10,30]],["\u0924\u0941\u0932\u0938\u0940 \u092C\u093E\u092C\u093E \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",0,[22,30]],["\u0924\u0941\u0932\u0938\u0940 \u092E\u093E\u0924\u093E \u0915\u0940 \u0915\u0939\u093E\u0928\u0940 \u091B\u094B\u091F\u0940",0,[22,30]],["\u0924\u0941\u0932\u0938\u0940 \u0930\u0924\u094D\u0928\u093E\u0935\u0932\u0940 \u0915\u0940 \u0915\u0939\u093E\u0928\u0940",0,[22,30]]],{"k":1}])